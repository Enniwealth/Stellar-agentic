  {
    "function_v0": {
      "doc": "Create an escrow job. Locks `amount` tokens from requester.\\n\\n# Arguments\\n* `requester` - Agent requesting the work\\n* `token` - Token to pay with\\n* `amount` - Payment for completing the job\\n* `task_description` - Description / IPFS hash of what needs doing\\n* `deadline_ledger` - After this ledger, requester can claim a refund\\n* `arbiter` - Optional trusted address for dispute resolution",
      "name": "create_job",
      "inputs": [
        {
          "doc": "",
          "name": "requester",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "token",
          "type_": "address"
        },
        {
          "doc": "",
          "name": "amount",
          "type_": "i128"
        },
        {
          "doc": "",
          "name": "task_description",
          "type_": "bytes"
        },
        {
          "doc": "",
          "name": "deadline_ledger",
          "type_": "u32"
        },
        {
          "doc": "",
          "name": "arbiter",
          "type_": {
            "option": {
              "value_type": "address"
            }
          }
        }
      ],
      "outputs": [
        "u64"
      ]
    }
  },
