{
  "title": "StellarAgent — Payments & Indexer",
  "uid": "stellaragent-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "Payment latency (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(stellaragent_payment_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(stellaragent_payment_latency_ms_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Payment failures by error code",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (stellaragent_error_code) (rate(stellaragent_payment_failures_total[5m]))",
          "legendFormat": "{{stellaragent_error_code}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Indexer lag (ledgers)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [
        { "expr": "stellaragent_indexer_lag_ledgers" }
      ]
    },
    {
      "type": "stat",
      "title": "Events indexed / min",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [
        { "expr": "rate(stellaragent_indexer_throughput_events[1m]) * 60" }
      ]
    },
    {
      "type": "stat",
      "title": "Decode failures",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 8 },
      "targets": [
        { "expr": "increase(stellaragent_indexer_decode_failures_total[1h])" }
      ]
    }
  ]
}
