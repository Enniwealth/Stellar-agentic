    "@stellaragent/mcp-server": "workspace:*"
  },
  "peerDependencies": {
    "@langchain/core": "^0.3.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "license": "MIT"
}
