{
  "name": "@stellaragent/langchain",
  "version": "0.1.0",
  "description": "LangChain tools for StellarAgent payments",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
